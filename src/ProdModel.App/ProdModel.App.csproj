<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ProdModel.App</RootNamespace>
    <AssemblyName>ProdModel.App</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <!-- CLIPSCLRWrapper � ��������� (managed + native) ������ x86, ������� ���� ������� ������ ���� 32-������. -->
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProdModel.Core\ProdModel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ������ ������ CLIPS ��� ����������� ������. -->
    <Reference Include="CLIPSCLRWrapper">
      <HintPath>lib\CLIPSCLRWrapper.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\data\*.clp" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProdModel.UiTests" />
  </ItemGroup>

</Project>
