<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0-windows</TargetFramework>
	<UseWindowsForms>true</UseWindowsForms>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<LangVersion>latest</LangVersion>
	<IsPackable>false</IsPackable>
	<RootNamespace>ProdModel.UiTests</RootNamespace>
	<AssemblyName>ProdModel.UiTests</AssemblyName>
	<!-- Приложение 32-битное из-за CLIPSCLRWrapper — тестовый хост должен быть таким же. -->
	<PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
	<PackageReference Include="xunit" Version="2.9.3" />
	<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
	<PackageReference Include="Xunit.StaFact" Version="1.2.69" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\..\src\ProdModel.App\ProdModel.App.csproj" />
	<ProjectReference Include="..\..\src\ProdModel.Core\ProdModel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
	<None Include="..\..\data\*.txt" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	<None Include="..\..\data\*.clp" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
